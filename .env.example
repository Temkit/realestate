# ── Immo search (existing) ────────────────────────────────────────────
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Brave / Gemini (Vertex) / Firecrawl / Upstash keys as already configured
# in .env.local — see the existing pipeline setup.

# ── Marketplace (services) ────────────────────────────────────────────

# Admin back-office (/admin). Required to log in.
ADMIN_PASSWORD=
# Optional: dedicated admin session-cookie secret. Falls back to ADMIN_PASSWORD.
ADMIN_SESSION_SECRET=

# REQUIRED for the provider portal + all provider-facing magic links
# (dispatch replies, appointment confirm/cancel, provider login + session).
# Generate: openssl rand -hex 32
# MUST be distinct from ADMIN_PASSWORD — providers receive HMACs signed with
# this key, so reusing the admin password would expose it to brute force.
# When unset, provider-facing signing fails closed (login + magic links won't work).
MARKETPLACE_SIGNING_SECRET=

# Transactional email (lead dispatch, confirmations, reminders, portal login).
# Without it, sends are logged instead and lead dispatches stay 'pending'
# for manual retry in the admin inbox.
RESEND_API_KEY=
# Verified sender. Defaults to Resend's onboarding@resend.dev sandbox.
MARKETPLACE_EMAIL_FROM=lux24 <onboarding@resend.dev>
# Where "claim this listing" requests are emailed. Default pro@lux24.lu.
MARKETPLACE_OPS_EMAIL=pro@lux24.lu

# Absolute site origin used to build magic links in emails.
NEXT_PUBLIC_SITE_URL=https://lux24.lu

# QStash — appointment reminders (one-shot) + monthly GDPR lead purge cron.
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
